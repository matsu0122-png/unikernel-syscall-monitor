$(eval $(call addlib_s,libvmitrace,$(CONFIG_LIBVMITRACE)))

CINCLUDES-$(CONFIG_LIBVMITRACE)	+= -I$(LIBVMITRACE_BASE)/include
LIBVMITRACE_CINCLUDES		+= -I$(LIBVMITRACE_BASE)

LIBVMITRACE_SRCS-y += $(LIBVMITRACE_BASE)/vmitrace.c
LIBVMITRACE_SRCS-y += $(LIBVMITRACE_BASE)/vmitrace_ring.S
LIBVMITRACE_SRCS-y += $(LIBVMITRACE_BASE)/vmitrace_hdr.lds.S
LIBVMITRACE_SRCS-y += $(LIBVMITRACE_BASE)/vmitrace_text.lds.S
