$(eval $(call addlib_s,libvmitrace,$(CONFIG_LIBVMITRACE)))

CINCLUDES-$(CONFIG_LIBVMITRACE)	+= -I$(LIBVMITRACE_BASE)/include
LIBVMITRACE_CINCLUDES		+= -I$(LIBVMITRACE_BASE)

LIBVMITRACE_SRCS-y += $(LIBVMITRACE_BASE)/vmitrace.c
LIBVMITRACE_SRCS-y += $(LIBVMITRACE_BASE)/vmitrace_ring.S
LIBVMITRACE_SRCS-y += $(LIBVMITRACE_BASE)/vmitrace_hdr.lds.S
LIBVMITRACE_SRCS-y += $(LIBVMITRACE_BASE)/vmitrace_text.lds.S

################################################################################
# Per-build random nonce in the header (identifies the build to the host)
################################################################################
# Regenerated by every make run (phony, as syscall_shim does for
# provided_syscalls.in.new), so vmitrace.o is recompiled and each image gets
# a new value. tools/gen_manifest.py reads the value back from the ELF.
LIBVMITRACE_CINCLUDES += -I$(LIBVMITRACE_BUILD)

$(LIBVMITRACE_BUILD)/vmitrace_nonce.h:
	$(call build_cmd,GEN,libvmitrace,$(notdir $@), \
		set -- $$(od -An -N16 -tx8 /dev/urandom) && \
		printf '#define VMITRACE_BUILD_NONCE0 0x%sULL\n#define VMITRACE_BUILD_NONCE1 0x%sULL\n' "$$1" "$$2" > $@)

.PHONY: $(LIBVMITRACE_BUILD)/vmitrace_nonce.h

$(LIBVMITRACE_BUILD)/vmitrace.o: $(LIBVMITRACE_BUILD)/vmitrace_nonce.h

LIBVMITRACE_CLEAN += $(LIBVMITRACE_BUILD)/vmitrace_nonce.h
