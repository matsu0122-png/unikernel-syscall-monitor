--- pristine/hw/nvram/fw_cfg.c	2026-08-23 13:55:08.000000000 +0900
+++ patched/hw/nvram/fw_cfg.c	2026-08-23 16:36:27.920568617 +0900
@@ -42,6 +42,28 @@
 #include "qapi/error.h"
 #include "hw/acpi/aml-build.h"
 #include "hw/pci/pci_bus.h"
+#include "qemu/main-loop.h"
+#include "hw/core/cpu.h"
